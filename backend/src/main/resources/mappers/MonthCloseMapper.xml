<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cost.shared.monthclose.MonthCloseMapper">
    <resultMap id="row" type="cost.shared.monthclose.MonthCloseRow">
        <result column="close_month" property="closeMonth" />
        <result column="status" property="status" />
    </resultMap>
    <select id="selectRange" resultMap="row">
        SELECT
            close_month, status
        FROM fin_month_close
        WHERE close_month &gt;= #{from}
          AND close_month &lt;= #{to}
        ORDER BY close_month
    </select>
</mapper>
